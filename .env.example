# Production settings for compose.prod.yaml. Copy to .env on the server and fill in.
# Generate each secret with:  openssl rand -base64 32
# Never commit the real .env (it is git-ignored).

# The public host name, e.g. fleetpulse.duckdns.org. Caddy gets an HTTPS certificate for it.
FLEETPULSE_DOMAIN=

# Signs login tokens. At least 32 random characters.
FLEETPULSE_JWT_SECRET=

# Password for the demo accounts (demo-admin@example.com etc.).
FLEETPULSE_DEMO_PASSWORD=

# Database password, used when the database is first created.
POSTGRES_PASSWORD=

# One broker login per service (see infra/mosquitto/acl for what each may do).
MQTT_SIMULATOR_PASSWORD=
MQTT_WORKER_PASSWORD=
MQTT_API_PASSWORD=
MQTT_HEALTHCHECK_PASSWORD=
