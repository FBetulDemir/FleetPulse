  "components": {
    "schemas": {
      "DemoLoginRequest": {
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "type": "object",
        "required": [
          "role"
        ],
        "title": "DemoLoginRequest"
      },
      "FieldError": {
        "properties": {
          "location": {
            "type": "string",
            "title": "Location"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "location",
          "message"
        ],
        "title": "FieldError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "default": "about:blank"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "title",
          "status"
        ],
        "title": "Problem"
      },
      "Role": {
        "type": "string",
        "enum": [
          "admin",
          "operator",
          "viewer"
        ],
        "title": "Role"
      },
      "UserOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "display_name",
          "role"
        ],
        "title": "UserOut"
      },
      "VesselCreate": {
        "properties": {
          "identifier": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "title": "Identifier"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "vessel_type": {
            "$ref": "#/components/schemas/VesselType"
          },
          "length_m": {
            "type": "number",
            "exclusiveMaximum": 10000.0,
            "exclusiveMinimum": 0.0,
            "title": "Length M"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "identifier",
          "name",
          "vessel_type",
          "length_m"
        ],
        "title": "VesselCreate"
      },
      "VesselOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "identifier": {
            "type": "string",
            "title": "Identifier"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "vessel_type": {
            "$ref": "#/components/schemas/VesselType"
          },
          "length_m": {
            "type": "number",
            "title": "Length M"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "identifier",
          "name",
          "vessel_type",
          "length_m",
          "is_active",
          "created_at",
          "updated_at"
        ],
        "title": "VesselOut"
      },
      "VesselPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/VesselOut"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "VesselPage"
      },
      "VesselType": {
        "type": "string",
        "enum": [
          "ferry",
          "pilot",
          "research",
          "workboat"
        ],
        "title": "VesselType"
      },
      "VesselUpdate": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "vessel_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VesselType"
              },
              {
                "type": "null"
              }
            ]
          },
          "length_m": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMaximum": 10000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Length M"
          },
          "is_active": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Active"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "VesselUpdate",
        "description": "Partial update: only the fields sent are changed. The identifier cannot change,\nbecause it links the vessel to its device and stored telemetry."
      }
    }
  }
}
